[{"text":"Uyandın.","start":0.31,"end":0.76},{"text":"Takvim 1999'u gösteriyor.","start":1.74,"end":4.06},{"text":"Cebinde 2026'dan kalma bir telefon var.","start":5.1,"end":8.23},{"text":"Birinci problem.","start":9.02,"end":9.78},{"text":"Paran burada geçmiyor.","start":10.57,"end":11.5},{"text":"Bir dolar, yarım milyon lira.","start":12.13,"end":13.96},{"text":"200 liralıkların burada sahte para.","start":14.79,"end":16.75},{"text":"Telefonun yüzde dokuz şarjda.","start":17.25,"end":19.51},{"text":"Ama bir bilgin var.","start":20.31,"end":21.22},{"text":"Galatasaray, UEFA Kupası'nı alacak.","start":22,"end":24.25},{"text":"Herkese anlatabilirsin.","start":25.28,"end":26.27},{"text":"Ya da susabilirsin.","start":27.2,"end":28.13},{"text":"Sen olsan ne yapardın?","start":29.36,"end":30.41}]
