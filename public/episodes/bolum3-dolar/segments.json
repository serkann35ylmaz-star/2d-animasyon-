[
 {
  "text": "Yorumlar konuştu: Dolar.",
  "start": 0.0,
  "end": 1.87
 },
 {
  "text": "Necmi'nin masasına hiç dönmedin.",
  "start": 2.94,
  "end": 4.58
 },
 {
  "text": "Ertesi sabah döviz bürosundasın.",
  "start": 5.52,
  "end": 7.25
 },
 {
  "text": "50 milyon lira, 111 dolar etti.",
  "start": 8.03,
  "end": 10.23
 },
 {
  "text": "Ayakkabılarının parası, bir avuç yeşil kâğıt.",
  "start": 11.0,
  "end": 13.44
 },
 {
  "text": "Az görünüyor. Ama sen biliyorsun.",
  "start": 14.47,
  "end": 16.36
 },
 {
  "text": "Kara Çarşamba'da, Şubat 2001'de, bu dolar katlanacak.",
  "start": 17.29,
  "end": 20.81
 },
 {
  "text": "Ama asıl plan bu değil.",
  "start": 21.7,
  "end": 22.97
 },
 {
  "text": "Defterine yeni bir satır yazıyorsun: 3 Ocak 2009.",
  "start": 23.83,
  "end": 27.24
 },
 {
  "text": "Bitcoin. Dünyanın ilk kripto parası.",
  "start": 28.17,
  "end": 30.71
 },
 {
  "text": "Mayıs 2010'da biri, 10.000 Bitcoin'le iki pizza alacak.",
  "start": 31.44,
  "end": 34.61
 },
 {
  "text": "Senin 111 dolarınla binlerce Bitcoin alabilirsin.",
  "start": 35.44,
  "end": 38.38
 },
 {
  "text": "Tek sorun: on yıl beklemek.",
  "start": 39.2,
  "end": 40.83
 },
 {
  "text": "Ve bu dolarları on yıl boyunca saklamak.",
  "start": 41.69,
  "end": 44.02
 },
 {
  "text": "Bankaya da yatıramazsın. Kimliğin 2026'dan.",
  "start": 44.74,
  "end": 47.39
 },
 {
  "text": "Dolarları yastığının altına saklıyorsun.",
  "start": 48.14,
  "end": 50.18
 },
 {
  "text": "On yıl. Her gece aynı yastık.",
  "start": 50.98,
  "end": 52.94
 },
 {
  "text": "O gece kapı çalıyor.",
  "start": 53.83,
  "end": 54.78
 },
 {
  "text": "Kapıda Necmi var.",
  "start": 55.57,
  "end": 56.43
 },
 {
  "text": "Seni kahvehaneden beri takip ediyormuş.",
  "start": 57.27,
  "end": 59.23
 },
 {
  "text": "\"Parayı getirmedin,\" dedi.",
  "start": 60.0,
  "end": 61.31
 },
 {
  "text": "\"Galatasaray'ı nereden biliyorsun?\"",
  "start": 62.06,
  "end": 63.39
 },
 {
  "text": "Necmi senin bir şey bildiğini anladı.",
  "start": 64.13,
  "end": 65.49
 },
 {
  "text": "Ve o, bu sırrı istiyor.",
  "start": 66.53,
  "end": 68.29
 },
 {
  "text": "Sen olsan ne yapardın?",
  "start": 69.11,
  "end": 70.19
 }
]