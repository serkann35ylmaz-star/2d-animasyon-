[
 {
  "text": "Yorumlar konuştu: Kal. Kazanan yorum, fuat.bmyc'den.",
  "start": 0.0,
  "end": 3.92
 },
 {
  "text": "İlk mola. Herkes otobüsten indi.",
  "start": 4.44,
  "end": 6.61
 },
 {
  "text": "Sen kaldın.",
  "start": 7.12,
  "end": 7.56
 },
 {
  "text": "Defterli adam da indi. Sonra geri döndü.",
  "start": 8.31,
  "end": 10.51
 },
 {
  "text": "Otobüste sadece ikiniz vardınız.",
  "start": 11.07,
  "end": 12.94
 },
 {
  "text": "Yanına oturdu. Defterini açık bırakıp çay almaya indi.",
  "start": 13.4,
  "end": 16.43
 },
 {
  "text": "Tuzak mıydı, bilmiyordun. Ama baktın.",
  "start": 16.86,
  "end": 19.24
 },
 {
  "text": "Necmi'nin borçlular listesi.",
  "start": 19.75,
  "end": 21.44
 },
 {
  "text": "Ve bir isimde kalbin durdu. Babanın adı.",
  "start": 21.89,
  "end": 24.52
 },
 {
  "text": "Borç: 5 milyar lira. Son ödeme: 17 Mayıs 2000.",
  "start": 24.92,
  "end": 28.81
 },
 {
  "text": "O zaman hatırladın.",
  "start": 29.25,
  "end": 30.11
 },
 {
  "text": "2000 baharında evinizi kaybettiniz. Sen 7 yaşındaydın.",
  "start": 30.6,
  "end": 33.93
 },
 {
  "text": "Baban sebebini hiç söylemedi. Sebep buymuş.",
  "start": 34.42,
  "end": 37.11
 },
 {
  "text": "Necmi'ye 50 milyon yatırsaydın, bire yüzden tam 5 milyar alacaktın.",
  "start": 37.56,
  "end": 41.51
 },
 {
  "text": "5 milyar, bugün 11 bin dolar. Cebinde 91 dolar var.",
  "start": 41.9,
  "end": 45.8
 },
 {
  "text": "Adam geri döndü. Yüzüne uzun uzun baktı.",
  "start": 46.38,
  "end": 48.97
 },
 {
  "text": "\"Sen bana birini hatırlatıyorsun,\" dedi.",
  "start": 49.39,
  "end": 51.41
 },
 {
  "text": "\"Necmi'nin bir borçlusuna tıpatıp benziyorsun.\"",
  "start": 51.75,
  "end": 54.07
 },
 {
  "text": "Otobüs kalkmak üzere.",
  "start": 54.42,
  "end": 55.48
 },
 {
  "text": "Sen olsan ne yapardın?",
  "start": 55.84,
  "end": 56.92
 }
]