[
 {
  "text": "Kimseye söylemedin.",
  "start": 0.0,
  "end": 0.97
 },
 {
  "text": "Cebinde tek kuruş yok.",
  "start": 1.47,
  "end": 2.59
 },
 {
  "text": "Telefonun ölmek üzere.",
  "start": 2.96,
  "end": 4.01
 },
 {
  "text": "Şarj da edemezsin. USB-C, 2014'e kadar icat edilmeyecek.",
  "start": 4.35,
  "end": 8.44
 },
 {
  "text": "Bildiğin her şeyi bir deftere yazıyorsun.",
  "start": 8.93,
  "end": 10.64
 },
 {
  "text": "En önemlisi: Şubat 2001'de büyük kriz geliyor.",
  "start": 11.02,
  "end": 13.76
 },
 {
  "text": "Dolar iki yılda neredeyse üç katına çıkacak.",
  "start": 14.06,
  "end": 16.35
 },
 {
  "text": "Ekran karardı. Geriye defter kaldı.",
  "start": 16.76,
  "end": 18.72
 },
 {
  "text": "Ama asıl şok başka.",
  "start": 19.24,
  "end": 20.51
 },
 {
  "text": "Bu şehirde ailen de yaşıyor.",
  "start": 20.87,
  "end": 22.18
 },
 {
  "text": "Ve yedi yaşındaki sen.",
  "start": 22.6,
  "end": 23.59
 },
 {
  "text": "Onları bulabilirsin.",
  "start": 24.02,
  "end": 24.84
 },
 {
  "text": "Ya da uzak durabilirsin.",
  "start": 25.27,
  "end": 26.42
 },
 {
  "text": "Sen olsan ne yapardın?",
  "start": 26.82,
  "end": 27.78
 }
]